							]
						},
						"method": "PATCH",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isDisliked\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/meal/plan/:planId/items/:mealTime/dislike",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"meal",
								"plan",
								":planId",
								"items",
								":mealTime",
								"dislike"
							],
							"variable": [
								{
									"key": "planId",
									"value": "665f8e3f9a721c0017a0b3f5",
									"description": "The MongoDB _id of the meal plan document"
								},
								{
									"key": "mealTime",
									"value": "breakfast",
									"description": "One of: breakfast, lunch, dinner, snack"
								}
							]
						},
						"description": "Marks a meal plan item as disliked. Automatically clears the `isLiked` flag if set. The response also includes `suggestedAlternative` — the next available meal variant for this meal time.\n\n**Body:**\n- `isDisliked` (boolean, optional) — if omitted, toggles the current state\n\n**Response includes:**\n- `isDisliked` — current state\n- `suggestedAlternative` — next variant (food, calories, protein, carbs, fats)\n- `plan` — full updated meal plan"
					},
					"response": []
				},
